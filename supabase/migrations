do $$
declare
  table_name text;
begin
  foreach table_name in array array[
    'active_brands', 'inventory_uploads', 'reorder_reports', 'analysis_snapshots', 'planner_feedback'
  ] loop
    if not exists (
      select 1 from pg_publication_tables
      where pubname = 'supabase_realtime'
