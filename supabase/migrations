-- Verification: every application table should show RLS enabled (true).
select n.nspname as schema_name, c.relname as table_name, c.relrowsecurity as rls_enabled
from pg_class c
join pg_namespace n on n.oid = c.relnamespace
where n.nspname = 'public'
  and c.relname in (
    'profiles', 'organizations', 'organization_members', 'workspace_settings',
    'active_brands', 'inventory_uploads', 'inventory_items', 'reorder_reports',
    'reorder_report_rows', 'analysis_snapshots', 'planner_feedback'
  )
order by c.relname;
