  sort_rank integer,
  brand text not null default '',
  model_number text not null,
  item_title text,
  item_status text,
  avg_monthly numeric(16,3) not null default 0,
  open_client_qty numeric(16,3) not null default 0,
  on_hand numeric(16,3) not null default 0,
  stock_available numeric(16,3) not null default 0,
  ats numeric(16,3) not null default 0,
  open_supplier_qty numeric(16,3) not null default 0,
  planning_supplier_qty numeric(16,3) not null default 0,
  supplier_window text,
  days_until_supplier integer,
  lead_time_days numeric(10,2),
  recommended_qty numeric(18,3) not null default 0 check (recommended_qty >= 0),
  reorder_status text not null default 'REORDER',
