-- Stark Supply Chain Intelligence
-- Initial secure Supabase schema for US, EU and Canada workspaces.
-- Run this entire file once in Supabase SQL Editor as the project owner.

begin;

create extension if not exists pgcrypto;
create schema if not exists private;

create or replace function public.set_updated_at()
returns trigger
language plpgsql
set search_path = ''
as $$
begin
  new.updated_at = now();
  return new;
end;
$$;

create table if not exists public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  email text,
  display_name text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.organizations (
  id uuid primary key default gen_random_uuid(),
  name text not null check (char_length(btrim(name)) between 2 and 120),
  slug text not null unique check (slug ~ '^[a-z0-9]+(?:-[a-z0-9]+)*$'),
  created_by uuid not null references auth.users(id) on delete restrict,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.organization_members (
  organization_id uuid not null references public.organizations(id) on delete cascade,
  user_id uuid not null references auth.users(id) on delete cascade,
  role text not null default 'viewer' check (role in ('owner', 'admin', 'planner', 'viewer')),
  created_by uuid references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  primary key (organization_id, user_id)
);

create table if not exists public.workspace_settings (
  organization_id uuid not null references public.organizations(id) on delete cascade,
  region text not null check (region in ('US', 'EU', 'CA')),
  critical_stock numeric(14,3) not null default 3 check (critical_stock >= 0),
  coverage_months numeric(8,3) not null default 1 check (coverage_months >= 0),
  supplier_delay_days integer not null default 15 check (supplier_delay_days between 0 and 3650),
  abc_a_threshold numeric(5,2) not null default 80 check (abc_a_threshold > 0 and abc_a_threshold < 100),
  abc_b_threshold numeric(5,2) not null default 95 check (abc_b_threshold > 0 and abc_b_threshold <= 100),
  updated_by uuid references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  primary key (organization_id, region),
  check (abc_b_threshold > abc_a_threshold)
);

create table if not exists public.active_brands (
  id uuid primary key default gen_random_uuid(),
  organization_id uuid not null references public.organizations(id) on delete cascade,
  region text not null check (region in ('US', 'EU', 'CA')),
  brand text not null check (char_length(btrim(brand)) between 1 and 180),
  brand_key text generated always as (lower(btrim(brand))) stored,
  is_active boolean not null default true,
  lead_time_days numeric(10,2) check (lead_time_days is null or lead_time_days >= 0),
  shipping_cost_responsibility text not null default 'unknown' check (shipping_cost_responsibility in ('us', 'supplier', 'unknown')),
  shipping_info_available boolean,
  pallet_option boolean,
  source text not null default 'system' check (source in ('system', 'manual', 'import')),
  notes text,
  created_by uuid references auth.users(id) on delete set null,
  updated_by uuid references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (organization_id, region, brand_key)
);

create table if not exists public.inventory_uploads (
  id uuid primary key default gen_random_uuid(),
  organization_id uuid not null references public.organizations(id) on delete cascade,
  region text not null check (region in ('US', 'EU', 'CA')),
  report_type text not null check (report_type in ('raw_inventory', 'sales_history', 'price_cost', 'ats', 'analysis_source')),
  file_name text not null,
  storage_path text,
  content_sha256 text,
  row_count integer not null default 0 check (row_count >= 0),
  status text not null default 'uploaded' check (status in ('uploaded', 'processing', 'ready', 'failed', 'archived')),
  error_message text,
  metadata jsonb not null default '{}'::jsonb,
  uploaded_by uuid not null references auth.users(id) on delete restrict,
  uploaded_at timestamptz not null default now(),
  processed_at timestamptz,
  unique (id, organization_id, region)
);

create table if not exists public.inventory_items (
  id uuid primary key default gen_random_uuid(),
  upload_id uuid not null,
  organization_id uuid not null,
  region text not null check (region in ('US', 'EU', 'CA')),
  source_row integer check (source_row is null or source_row > 0),
  brand text not null default '',
  item_id text,
  model_number text not null,
  item_title text,
  item_status text,
  eta date,
  volume_past_3m numeric(16,3) not null default 0,
  volume_last_30_days numeric(16,3) not null default 0,
  avg_monthly numeric(16,3) not null default 0,
  on_hand numeric(16,3) not null default 0,
  stock_available numeric(16,3) not null default 0,
  ats numeric(16,3) not null default 0,
  open_client_qty numeric(16,3) not null default 0,
  open_supplier_qty numeric(16,3) not null default 0,
  supplier_due_qty numeric(16,3),
  supplier_start date,
  supplier_end date,
  supplier_window text,
  supplier_pos text,
  raw_data jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now(),
  foreign key (upload_id, organization_id, region)
    references public.inventory_uploads(id, organization_id, region) on delete cascade
